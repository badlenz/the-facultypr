# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://your-domain.vercel.app"

# SMTP configuration for Booking Notifications
# Host defaults to smtp.gmail.com if not specified
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
# The email address that authenticates with the SMTP server
SMTP_USER="your_email@gmail.com"
# A Gmail App Password (generated in your Google Account security settings)
SMTP_PASS="your_gmail_app_password"

# Google OAuth credentials for Google Sheets synchronization
GOOGLE_OAUTH_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID"
GOOGLE_OAUTH_CLIENT_SECRET="YOUR_GOOGLE_OAUTH_CLIENT_SECRET"
GOOGLE_OAUTH_REFRESH_TOKEN="YOUR_GOOGLE_OAUTH_REFRESH_TOKEN"

# External URL for the independent Artist Portal (defaults to https://la-facultad-studio.vercel.app)
VITE_ARTIST_PORTAL_URL="https://la-facultad-studio.vercel.app"

# Stripe Checkout
STRIPE_SECRET_KEY="sk_or_rk_replace"
VITE_STRIPE_PUBLISHABLE_KEY="pk_replace"

# Resend Email Notifications
RESEND_API_KEY="re_replace"
RESEND_FROM="La Facultad Studio <reservas@example.com>"
ADMIN_EMAIL="admin@example.com"

# Google Apps Script Bridge (#21 El Cronomante & Calendar/Drive)
GUILD_GOOGLE_BRIDGE_URL="https://script.google.com/macros/s/your-deployment-id/exec"
GUILD_GOOGLE_BRIDGE_SECRET="replace-with-random-secret"

# Telegram Bot Notifications
GUILD_TELEGRAM_BOT_TOKEN=""
GUILD_TELEGRAM_CHAT_ID=""
