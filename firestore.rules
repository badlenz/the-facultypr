rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Users and artist profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Recibos and digital receipts
    match /recibos/{reciboId} {
      allow read, write: if true;
    }

    // Archivos de sesion (stems, mezclas, masters)
    match /archivos/{archivoId} {
      allow read, write: if true;
    }

    // Clientes collection
    match /clientes/{clienteId} {
      allow read, write: if true;
    }

    // Reservas collection
    match /reservas/{reservaId} {
      allow read, write: if true;
    }

    // Showcase Tracks collection
    match /showcase_tracks/{trackId} {
      allow read, write: if true;
    }

    // Song Feedbacks collection
    match /song_feedbacks/{feedbackId} {
      allow read, write: if true;
    }

    match /feedbacks/{feedbackId} {
      allow read, write: if true;
    }

    // Studio config
    match /studio_config/{configId} {
      allow read, write: if true;
    }

    // Promo slots counter
    match /promo_slots/{slotId} {
      allow read, write: if true;
    }

    // Test connection doc
    match /test/{testId} {
      allow read, write: if true;
    }

    // Fallback catch-all rule
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
