rules_version = '2';

// ===============================================================
// Assumed Data Model — La Facultad Studio (the-facultypr.vercel.app)
// ===============================================================
//
// Collection: reservas (CONTAINS CLIENT/FINANCIAL DATA — admin-only read/delete)
// Document ID: reservaId (matches data.id, e.g., PS_ARTISTA)
// Fields:
//   - id: string (required, immutable, 1..128 chars, == reservaId)
//   - clienteId: string (optional, <= 128 chars)
//   - slotId: string (optional, <= 128 chars, links to agenda_ocupada/{slotId})
//   - nombreArtistico: string (required, 1..120 chars)
//   - fecha: string (required, 1..32 chars)
//   - fechasBloque: list (optional, <= 30 items)
//   - horaInicio: string (required, 1..20 chars)
//   - horaSalida: string (required, 1..20 chars)
//   - totalHoras: number (optional, 0..500)
//   - servicios: list (optional, <= 30 items)
//   - metodoPago: string (optional, enum: Efectivo | ATH Movil | Tarjeta / Stripe | PayPal | Zelle)
//   - subtotal: number (required, 0..100000)
//   - deposito: number (required, 0..100000)
//   - balance: number (required, 0..100000)
//   - estado: string (required, enum: Pendiente | Confirmada | En Proceso | Completada | Cancelada | Liberada)
//   - depositoEstado: string (optional, enum: depositado | pendiente | paga_en_sesion)
//   - firma: string (optional, base64 signature <= 300000 chars)
//   - creadoEn: number (optional, epoch ms >= 0)
//   - comprobanteAthUrl: string (optional, URL or base64 <= 500000 chars)
//   - comprobanteNumReferencia: string (optional, <= 100 chars)
//   - reagendadoDeFecha: string (optional, <= 32 chars)
//   - motivoCancelacion: string (optional, <= 500 chars)
//   - roughMixUrl: string (optional, <= 2048 chars)
//   - roughMixNombre: string (optional, <= 200 chars)
//   - tipoProyecto: string (optional, enum: single | ep_3_tracks | ep_5_tracks | album_completo | pack_semanal)
//   - detallesTracklist: list (optional, <= 50 items)
//   - estrellaOtorgada: bool (optional)
//
// Collection: agenda_ocupada (SANITIZED PUBLIC AVAILABILITY — NO PII, NO FINANCIALS)
// Document ID: slotId (matches data.id)
// Fields:
//   - id: string (required, immutable, 1..128 chars, == slotId)
//   - fecha: string (required, 1..32 chars)
//   - fechasBloque: list (optional, <= 30 items)
//   - horaInicio: string (required, 1..20 chars)
//   - horaSalida: string (required, 1..20 chars)
//   - estado: string (required, enum: Pendiente | Confirmada | En Proceso | Completada | Cancelada | Liberada)
//   - tieneComprobante: bool (optional; public create must be false/null/omitted; public update only false -> true while Pendiente)
//   - creadoEn: number (required, epoch ms 0..9999999999999)
//
// Collection: clientes (CONTAINS PII — admin-only read/update/delete)
// Document ID: clienteId (matches data.id, e.g., CLI-1234)
// Fields:
//   - id: string (required, immutable, 1..128 chars, == clienteId)
//   - nombreArtistico: string (required, 1..120 chars)
//   - nombreReal: string (optional, <= 120 chars)
//   - email: string (optional, <= 160 chars)
//   - telefono: string (required, 1..40 chars)
//   - instagram: string (optional, <= 100 chars)
//   - fechaCreacion: string (optional, <= 40 chars)
//   - estrellasVip: number (optional, 0..20; public create must be 0 or omitted)
//   - codigoSesion: string (optional, <= 64 chars; public create must be empty or omitted)
//   - historialEstrellas: list (optional, <= 100 items; public create must be empty or omitted)
//
// Collection: leads_espera (CONTAINS PII — admin-only read/update/delete)
// Document ID: leadId (matches data.id, e.g., VIP-1234)
// Fields:
//   - id: string (required, immutable, 1..128 chars, == leadId)
//   - nombreArtistico: string (required, 1..120 chars)
//   - nombreReal: string (optional, <= 120 chars)
//   - telefono: string (required, 1..40 chars)
//   - email: string (optional, <= 160 chars)
//   - instagram: string (optional, <= 100 chars)
//   - tipoProyecto: string (required, enum: grabacion_voces | mezcla_master | album_ep | instrumental | otro)
//   - fechaTentativa: string (optional, <= 32 chars)
//   - motivoCierre: string (required, 1..200 chars)
//   - mensaje: string (optional, <= 1000 chars)
//   - fechaRegistro: string (required, 1..40 chars)
//   - contactado: bool (optional; public create must be false or omitted)
//
// Collection: studio_config, promo_slots, showcase_tracks
//   - Public read; admin-only write (studio_config/main includes metaMensualUsd, paypalMeUrl, etc.).
//
// Collection: test
//   - Public read (connectivity health check); no writes.
//
// Collection: finanzas (Admin-only studio ledger — income/expenses & monthly goal tracking)
// Document ID: movId (e.g., FIN-123456)
// Fields:
//   - id: string (required, == movId)
//   - fecha: string (required, YYYY-MM-DD)
//   - concepto: string (required)
//   - monto: number (required)
//   - tipo: string (required, enum: ingreso | gasto)
//   - metodoPago: string (required, enum: ATH Movil | Tarjeta / Stripe | PayPal | Efectivo)
//   - nota: string (optional)
//   - creadoEn: number (required, epoch ms)
//
// Collections: feedbacks, archivos, recibos, finanzas
//   - Admin-only read/write.
//
// Collection: reviews (PUBLIC TESTIMONIALS / REVIEWS — NO PII)
// Document ID: reviewId
// Fields:
//   - artistName: string (required, 2..60 chars)
//   - projectTitle: string (required, 2..80 chars)
//   - quote: string (required, 8..400 chars)
//   - rating: int (required, 1..5)
//   - featured: bool (required; public create must be false)
//   - featuredOrder: int or null (optional)
//   - source: string (optional, 1..40 chars)
//   - createdAt: int or timestamp (required, immutable on update)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Admin identified by Firebase Auth email claim.
    // Note: email_verified is intentionally not required so manually created
    // Firebase Console admin accounts work immediately.
    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email == 'ellentemalo@gmail.com';
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    function isValidOptionalString(data, field, maxLen) {
      return !(field in data) ||
        data[field] == null ||
        (data[field] is string && data[field].size() <= maxLen);
    }

    function isUnsetOrEmptyString(data, field) {
      return !(field in data) ||
        data[field] == null ||
        data[field] == '';
    }

    function isNumberInRange(val, minVal, maxVal) {
      return (val is int || val is float) && val >= minVal && val <= maxVal;
    }

    function isValidOptionalNumberRange(data, field, minVal, maxVal) {
      return !(field in data) ||
        data[field] == null ||
        isNumberInRange(data[field], minVal, maxVal);
    }

    function isValidOptionalList(data, field, maxSize) {
      return !(field in data) ||
        data[field] == null ||
        (data[field] is list && data[field].size() <= maxSize);
    }

    function isValidOptionalBool(data, field) {
      return !(field in data) ||
        data[field] == null ||
        data[field] is bool;
    }

    // ===============================================================
    // Domain Validators (Called on BOTH create and update)
    // ===============================================================

    function isValidReserva(data, reservaId) {
      return data.keys().hasOnly([
          'id', 'clienteId', 'slotId', 'nombreArtistico', 'fecha', 'fechasBloque',
          'horaInicio', 'horaSalida', 'totalHoras', 'servicios', 'metodoPago',
          'subtotal', 'deposito', 'balance', 'estado', 'depositoEstado',
          'firma', 'creadoEn', 'comprobanteAthUrl', 'comprobanteNumReferencia',
          'reagendadoDeFecha', 'motivoCancelacion', 'roughMixUrl',
          'roughMixNombre', 'tipoProyecto', 'detallesTracklist', 'estrellaOtorgada'
        ]) &&
        data.keys().hasAll([
          'id', 'nombreArtistico', 'fecha', 'horaInicio', 'horaSalida',
          'subtotal', 'deposito', 'balance', 'estado'
        ]) &&
        isNonEmptyString(data.id, 128) &&
        data.id == reservaId &&
        isValidOptionalString(data, 'clienteId', 128) &&
        isValidOptionalString(data, 'slotId', 128) &&
        isNonEmptyString(data.nombreArtistico, 120) &&
        isNonEmptyString(data.fecha, 32) &&
        isValidOptionalList(data, 'fechasBloque', 30) &&
        isNonEmptyString(data.horaInicio, 20) &&
        isNonEmptyString(data.horaSalida, 20) &&
        isValidOptionalNumberRange(data, 'totalHoras', 0, 500) &&
        isValidOptionalList(data, 'servicios', 30) &&
        (!('metodoPago' in data) || data.metodoPago == null ||
          data.metodoPago in ['Efectivo', 'ATH Movil', 'Tarjeta / Stripe', 'PayPal', 'Zelle']) &&
        isNumberInRange(data.subtotal, 0, 100000) &&
        isNumberInRange(data.deposito, 0, 100000) &&
        isNumberInRange(data.balance, 0, 100000) &&
        data.estado in ['Pendiente', 'Confirmada', 'En Proceso', 'Completada', 'Cancelada', 'Liberada'] &&
        (!('depositoEstado' in data) || data.depositoEstado == null ||
          data.depositoEstado in ['depositado', 'pendiente', 'paga_en_sesion']) &&
        isValidOptionalString(data, 'firma', 300000) &&
        isValidOptionalNumberRange(data, 'creadoEn', 0, 9999999999999) &&
        isValidOptionalString(data, 'comprobanteAthUrl', 500000) &&
        isValidOptionalString(data, 'comprobanteNumReferencia', 100) &&
        isValidOptionalString(data, 'reagendadoDeFecha', 32) &&
        isValidOptionalString(data, 'motivoCancelacion', 500) &&
        isValidOptionalString(data, 'roughMixUrl', 2048) &&
        isValidOptionalString(data, 'roughMixNombre', 200) &&
        (!('tipoProyecto' in data) || data.tipoProyecto == null ||
          data.tipoProyecto in ['single', 'ep_3_tracks', 'ep_5_tracks', 'album_completo', 'pack_semanal']) &&
        isValidOptionalList(data, 'detallesTracklist', 50) &&
        isValidOptionalBool(data, 'estrellaOtorgada');
    }

    function isValidPublicReservaCreate(data) {
      return data.estado == 'Pendiente' &&
        (!('depositoEstado' in data) || data.depositoEstado == null ||
          data.depositoEstado in ['pendiente', 'paga_en_sesion']) &&
        (!('estrellaOtorgada' in data) || data.estrellaOtorgada == null ||
          data.estrellaOtorgada == false);
    }

    function isValidPublicComprobanteUpdate() {
      let diffKeys = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.estado == 'Pendiente' &&
        diffKeys.hasOnly(['comprobanteAthUrl', 'comprobanteNumReferencia']) &&
        diffKeys.size() > 0 &&
        isUnsetOrEmptyString(resource.data, 'comprobanteAthUrl') &&
        isUnsetOrEmptyString(resource.data, 'comprobanteNumReferencia');
    }

    function isValidAgendaSlot(data, slotId) {
      return data.keys().hasOnly([
          'id', 'fecha', 'fechasBloque', 'horaInicio', 'horaSalida',
          'estado', 'tieneComprobante', 'creadoEn'
        ]) &&
        data.keys().hasAll([
          'id', 'fecha', 'horaInicio', 'horaSalida', 'estado', 'creadoEn'
        ]) &&
        isNonEmptyString(data.id, 128) &&
        data.id == slotId &&
        isNonEmptyString(data.fecha, 32) &&
        isValidOptionalList(data, 'fechasBloque', 30) &&
        isNonEmptyString(data.horaInicio, 20) &&
        isNonEmptyString(data.horaSalida, 20) &&
        data.estado in ['Pendiente', 'Confirmada', 'En Proceso', 'Completada', 'Cancelada', 'Liberada'] &&
        isValidOptionalBool(data, 'tieneComprobante') &&
        isNumberInRange(data.creadoEn, 0, 9999999999999);
    }

    function isValidPublicAgendaSlotCreate(data) {
      return data.estado == 'Pendiente' &&
        (!('tieneComprobante' in data) || data.tieneComprobante == null ||
          data.tieneComprobante == false);
    }

    function isValidPublicAgendaSlotComprobanteUpdate() {
      let diffKeys = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.estado == 'Pendiente' &&
        diffKeys.hasOnly(['tieneComprobante']) &&
        diffKeys.size() == 1 &&
        (!('tieneComprobante' in resource.data) || resource.data.tieneComprobante == null ||
          resource.data.tieneComprobante == false) &&
        request.resource.data.tieneComprobante == true;
    }

    function isValidCliente(data, clienteId) {
      return data.keys().hasOnly([
          'id', 'nombreArtistico', 'nombreReal', 'email', 'telefono',
          'instagram', 'fechaCreacion', 'estrellasVip', 'codigoSesion',
          'historialEstrellas', 'servicioFrecuente'
        ]) &&
        data.keys().hasAll(['id', 'nombreArtistico', 'telefono']) &&
        isNonEmptyString(data.id, 128) &&
        data.id == clienteId &&
        isNonEmptyString(data.nombreArtistico, 120) &&
        isNonEmptyString(data.telefono, 40) &&
        isValidOptionalString(data, 'nombreReal', 120) &&
        isValidOptionalString(data, 'email', 160) &&
        isValidOptionalString(data, 'instagram', 100) &&
        isValidOptionalString(data, 'fechaCreacion', 40) &&
        isValidOptionalNumberRange(data, 'estrellasVip', 0, 20) &&
        isValidOptionalString(data, 'codigoSesion', 64) &&
        isValidOptionalList(data, 'historialEstrellas', 100) &&
        isValidOptionalString(data, 'servicioFrecuente', 100);
    }

    function isValidPublicClienteCreate(data) {
      return (!('estrellasVip' in data) || data.estrellasVip == null || data.estrellasVip == 0) &&
        (!('codigoSesion' in data) || data.codigoSesion == null || data.codigoSesion == '' ||
          (data.codigoSesion is string && data.codigoSesion.matches('^vip-[abcdefghjkmnpqrstuvwxyz23456789]{12}$'))) &&
        (!('historialEstrellas' in data) || data.historialEstrellas == null || data.historialEstrellas.size() == 0);
    }

    function isValidVipPublico(data, codigo) {
      return codigo is string &&
        codigo.size() >= 6 &&
        codigo.size() <= 64 &&
        codigo.matches('^vip__[a-z0-9]([a-z0-9-]{0,46}[a-z0-9])?$') &&
        data.keys().hasOnly([
          'nombreArtistico', 'estrellasVip', 'nivel',
          'proximoHito', 'estrellasRestantes', 'hitosAlcanzados'
        ]) &&
        data.keys().hasAll([
          'nombreArtistico', 'estrellasVip', 'nivel',
          'proximoHito', 'estrellasRestantes', 'hitosAlcanzados'
        ]) &&
        isNonEmptyString(data.nombreArtistico, 120) &&
        isNumberInRange(data.estrellasVip, 0, 20) &&
        data.nivel is map &&
        data.nivel.keys().hasOnly(['label', 'shortLabel', 'color']) &&
        data.nivel.keys().hasAll(['label', 'shortLabel', 'color']) &&
        isNonEmptyString(data.nivel.label, 80) &&
        isNonEmptyString(data.nivel.shortLabel, 40) &&
        isNonEmptyString(data.nivel.color, 120) &&
        (data.proximoHito == null || (
          data.proximoHito is map &&
          data.proximoHito.keys().hasOnly(['pts', 'title', 'desc', 'badge']) &&
          data.proximoHito.keys().hasAll(['pts', 'title', 'desc', 'badge']) &&
          isNumberInRange(data.proximoHito.pts, 1, 20) &&
          isNonEmptyString(data.proximoHito.title, 100) &&
          isNonEmptyString(data.proximoHito.desc, 300) &&
          isNonEmptyString(data.proximoHito.badge, 60)
        )) &&
        isNumberInRange(data.estrellasRestantes, 0, 20) &&
        data.hitosAlcanzados is list &&
        data.hitosAlcanzados.size() <= 4;
    }

    function isValidLeadEspera(data, leadId) {
      return data.keys().hasOnly([
          'id', 'nombreArtistico', 'nombreReal', 'telefono', 'email',
          'instagram', 'tipoProyecto', 'fechaTentativa', 'motivoCierre',
          'mensaje', 'fechaRegistro', 'contactado'
        ]) &&
        data.keys().hasAll([
          'id', 'nombreArtistico', 'telefono', 'tipoProyecto',
          'motivoCierre', 'fechaRegistro'
        ]) &&
        isNonEmptyString(data.id, 128) &&
        data.id == leadId &&
        isNonEmptyString(data.nombreArtistico, 120) &&
        isValidOptionalString(data, 'nombreReal', 120) &&
        isNonEmptyString(data.telefono, 40) &&
        isValidOptionalString(data, 'email', 160) &&
        isValidOptionalString(data, 'instagram', 100) &&
        data.tipoProyecto in ['grabacion_voces', 'mezcla_master', 'album_ep', 'instrumental', 'otro'] &&
        isValidOptionalString(data, 'fechaTentativa', 32) &&
        isNonEmptyString(data.motivoCierre, 200) &&
        isValidOptionalString(data, 'mensaje', 1000) &&
        isNonEmptyString(data.fechaRegistro, 40) &&
        isValidOptionalBool(data, 'contactado');
    }

    function isValidReview(data) {
      return data.keys().hasOnly([
          'artistName', 'projectTitle', 'quote', 'rating',
          'featured', 'featuredOrder', 'source', 'createdAt'
        ]) &&
        data.keys().hasAll([
          'artistName', 'projectTitle', 'quote', 'rating',
          'featured', 'createdAt'
        ]) &&
        data.artistName is string &&
        data.artistName.size() >= 2 &&
        data.artistName.size() <= 60 &&
        data.projectTitle is string &&
        data.projectTitle.size() >= 2 &&
        data.projectTitle.size() <= 80 &&
        data.quote is string &&
        data.quote.size() >= 8 &&
        data.quote.size() <= 400 &&
        data.rating is int &&
        data.rating >= 1 &&
        data.rating <= 5 &&
        data.featured is bool &&
        (!('featuredOrder' in data) || data.featuredOrder == null || data.featuredOrder is int) &&
        (!('source' in data) || data.source == null ||
          (data.source is string && data.source.size() >= 1 && data.source.size() <= 40)) &&
        ((data.createdAt is int && data.createdAt >= 0) || data.createdAt is timestamp);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Public studio configuration, blocked dates, and status
    match /studio_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Promo Reapertura slot counters
    match /promo_slots/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // A/B Showcase audio tracks
    match /showcase_tracks/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Connectivity check document (read-only)
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Sanitized public availability slots (NO PII, NO financial amounts)
    // - Public can read availability, create 'Pendiente' slots (tieneComprobante false/unset),
    //   and flip tieneComprobante false -> true once while estado == 'Pendiente'.
    // - Only admin can confirm/complete/cancel/release or delete slots.
    match /agenda_ocupada/{slotId} {
      allow read: if true;
      allow create: if isValidAgendaSlot(request.resource.data, slotId) &&
        (isAdmin() || isValidPublicAgendaSlotCreate(request.resource.data));
      allow update: if isValidAgendaSlot(request.resource.data, slotId) &&
        request.resource.data.id == resource.data.id &&
        (isAdmin() || isValidPublicAgendaSlotComprobanteUpdate());
      allow delete: if isAdmin();
    }

    // Studio reservations (Level 3 security: admin-only read)
    // - No public visitor can list or read any client's reservation, amounts, signature, or receipts.
    // - Public can create 'Pendiente' bookings and submit ATH Movil proof ONCE while estado == 'Pendiente'
    //   (only modifying comprobanteAthUrl / comprobanteNumReferencia when both are currently unset/empty).
    // - Only admin can read, confirm/complete/cancel/release, or delete reservations.
    match /reservas/{reservaId} {
      allow read: if isAdmin();
      allow create: if isValidReserva(request.resource.data, reservaId) &&
        (isAdmin() || isValidPublicReservaCreate(request.resource.data));
      allow update: if isValidReserva(request.resource.data, reservaId) &&
        request.resource.data.id == resource.data.id &&
        (isAdmin() || isValidPublicComprobanteUpdate());
      allow delete: if isAdmin();
    }

    // CRM client records (contains PII: email, phone, real name)
    // - Public can only create a new client record during booking (0 VIP stars).
    // - Only admin can read, update, or delete client records.
    match /clientes/{clienteId} {
      allow read: if isAdmin();
      allow create: if isValidCliente(request.resource.data, clienteId) &&
        (isAdmin() || isValidPublicClienteCreate(request.resource.data));
      allow update: if isAdmin() &&
        isValidCliente(request.resource.data, clienteId) &&
        request.resource.data.id == resource.data.id;
      allow delete: if isAdmin();
    }

    // Waitlist leads when studio is paused (contains PII)
    match /leads_espera/{leadId} {
      allow read: if isAdmin();
      allow create: if isValidLeadEspera(request.resource.data, leadId) &&
        (isAdmin() || !('contactado' in request.resource.data) || request.resource.data.contactado == false);
      allow update: if isAdmin() &&
        isValidLeadEspera(request.resource.data, leadId) &&
        request.resource.data.id == resource.data.id;
      allow delete: if isAdmin();
    }

    // Admin-managed internal collections
    match /feedbacks/{feedbackId} {
      allow read, write: if isAdmin();
    }

    match /archivos/{archivoId} {
      allow read, write: if isAdmin();
    }

    match /recibos/{reciboId} {
      allow read, write: if isAdmin();
    }

    match /finanzas/{movId} {
      allow read, write: if isAdmin();
    }

    // Public studio reviews & testimonials (NO PII)
    // - Public can read reviews and submit new unfeatured reviews (featured == false).
    // - Only admin can update (toggle featured / featuredOrder) or delete reviews.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidReview(request.resource.data) &&
        (isAdmin() || request.resource.data.featured == false);
      allow update: if isAdmin() &&
        isValidReview(request.resource.data) &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    // Proyección pública segura del Pasaporte VIP (cero PII: sin email, teléfono, historial ni reservas)
    // - Permite únicamente lectura puntual por documento (allow get: if true); listado/consulta denegada.
    // - Creación pública solo con esquema exacto y estrellasVip == 0; actualización/borrado solo admin.
    match /vip_publico/{codigo} {
      allow get: if true;
      allow list: if false;
      allow create: if isValidVipPublico(request.resource.data, codigo) &&
        (isAdmin() || request.resource.data.estrellasVip == 0);
      allow update: if isAdmin() && isValidVipPublico(request.resource.data, codigo);
      allow delete: if isAdmin();
    }

    // Default deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
